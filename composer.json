{
    "name": "freescout-module-manager/module-manager",
    "description": "Install FreeScout modules from a GitHub repository or an uploaded ZIP file.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0",
        "guzzlehttp/guzzle": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\ModuleManager\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "Tests/"
        }
    }
}
